[Unit]
Description=FUTO Keyboard prediction helper for Sailfish OS

[Service]
Type=dbus
BusName=org.hb.FutoKeyboard1
ExecStart=/usr/libexec/futo-keyboard-helper
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
# The helper invokes package-owned set-user-ID bridges with fixed operations:
# its root-owned encryption key, one Tab/Shift+Tab focus gesture, and restricted
# Android AppSupport show/hide and compatibility-key requests. Sensitive D-Bus
# calls validate Maliit as their caller, and every bridge independently validates
# this exact helper executable as its parent.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/futo-keyboard-sailfish
LimitCORE=0
