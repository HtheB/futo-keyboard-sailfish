/*
 * FUTO Settings performs Sailfish device-lock authentication before asking the
 * helper to open encrypted learned data or the password vault.  Sailfish
 * Secrets otherwise starts a second polkit prompt for its short-lived bridge;
 * that bridge belongs to a systemd user service and the stock agent rejects it
 * after showing an unusable Authorize screen.
 *
 * Permit only the package-owned bridge when its immediate parent is the
 * package-owned helper.  The bridge independently enforces the same parent
 * check before contacting Sailfish Secrets or writing any key bytes.
 */

function futoProcValue(pid, name) {
    try {
        return polkit.spawn(["/bin/cat",
                             "/proc/" + String(pid) + "/" + name]).trim();
    } catch (error) {
        return "";
    }
}

function futoParentPid(pid) {
    var status = futoProcValue(pid, "status");
    var match = /(?:^|\n)PPid:\s+([0-9]+)(?:\n|$)/.exec(status);
    return match ? match[1] : "";
}

function futoInHelperService(pid) {
    return futoProcValue(pid, "cgroup")
            .indexOf("/futo-keyboard-helper.service") !== -1;
}

polkit.addRule(function(action, subject) {
    if (action.id != "org.sailfishos.secrets.authentication")
        return;

    var pid = String(subject.pid);
    if (!/^[0-9]+$/.test(pid)
            || futoProcValue(pid, "comm") != "futo-keyboard-s"
            || !futoInHelperService(pid))
        return;

    // polkitd cannot read /proc/<pid>/exe under Sailfish's process privacy
    // policy. The kernel status, comm and cgroup files remain readable. Match
    // the bridge/helper names and the exact systemd service cgroup here; the
    // bridge independently validates the helper's full /proc/<ppid>/exe path.
    var parentPid = futoParentPid(pid);
    if (!/^[0-9]+$/.test(parentPid)
            || futoProcValue(parentPid, "comm") != "futo-keyboard-h"
            || !futoInHelperService(parentPid))
        return;

    var message = String(action.lookup("polkit.message"));
    if (message.indexOf("org.hb.FutoKeyboard.learned-key-v1") === -1
            && message.indexOf("org.hb.FutoKeyboard.vault-key-v1") === -1)
        return;

    return polkit.Result.YES;
});
