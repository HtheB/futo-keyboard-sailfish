* text=auto

# Sailfish OS and Linux build/runtime files must retain Unix line endings.
*.sh text eol=lf
*.spec text eol=lf
Makefile text eol=lf
*.conf text eol=lf
*.desktop text eol=lf
*.policy text eol=lf
*.rules text eol=lf
*.service text eol=lf
*.qml text eol=lf
*.js text eol=lf
*.go text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Packaged media and models are binary assets.
*.bin binary
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.svg binary
*.ttf binary
*.webp binary
